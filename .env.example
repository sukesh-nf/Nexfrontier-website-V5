# Copy these into Netlify: Site settings -> Environment variables
# Do not commit a real .env file - this is a template only.

# Supabase project connection (public/anon - safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL used for metadata, sitemaps, canonical links
NEXT_PUBLIC_SITE_URL=https://nexfrontierlogic.nz

# Set to "true" only on the production deploy that should be indexed by search engines
SITE_INDEXING_ENABLED=

# Optional staging/preview toggle - leave unset on production
PREVIEW_MODE=
